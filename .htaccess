# Document root debe ser /public.
# Si el dominio apunta a la raíz del proyecto, reescribe todo hacia public/.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si ya está pidiendo algo dentro de public/, no reescribir de nuevo
    RewriteRule ^public/ - [L]

    # Archivos/carpetas reales en public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Front controller
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Por seguridad: no listar el directorio
Options -Indexes
