# Bloquear acceso directo a archivos subidos.
# Deben servirse solo vía /app/media (sesión autenticada).
# branding/ tiene su propia excepción para Open Graph público.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Defensa extra si el servidor ignora Require: nunca ejecutar scripts aquí.
<FilesMatch "\.(?i:php|phtml|phar|pl|py|cgi|asp|aspx|js\.map)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
